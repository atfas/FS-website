# Copy this file to .env and fill in the values.
# Both values are public (they end up in the page), so they are safe in the browser,
# but .env is not committed so each environment can use its own.

# Contact form delivery: get a free key at https://web3forms.com
# by entering the email that should receive the messages (e.g. geral@fernandesesaraiva.pt).
PUBLIC_WEB3FORMS_KEY=

# Booking calendar: the part of the Cal.com link after "cal.com/",
# e.g. for https://cal.com/fernandes-saraiva/consulta use: fernandes-saraiva/consulta
PUBLIC_CAL_LINK=
