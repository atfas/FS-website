---
import { contact } from '../data/content';
---

<section id="contact" class="section">
  <div class="container">
    <div class="section-header" data-reveal>
      <h2 class="section-title">Contactos</h2>
      <p class="section-subtitle">Ligue, envie um email ou visite-nos no escritório.</p>
    </div>

    <div class="contact-grid">
      <a href={contact.phoneHref} class="contact-card card" data-reveal>
        <span class="icon-circle"><i class="fas fa-phone" aria-hidden="true"></i></span>
        <span class="contact-label">Telefone</span>
        <span class="contact-value">{contact.phone}</span>
        <span class="contact-action">Tocar para ligar</span>
      </a>

      <a href={`mailto:${contact.email}`} class="contact-card card" data-reveal style="--reveal-delay: 100ms">
        <span class="icon-circle"><i class="fas fa-envelope" aria-hidden="true"></i></span>
        <span class="contact-label">Email</span>
        <span class="contact-value contact-email">{contact.email}</span>
        <span class="contact-action">Enviar email</span>
      </a>

      <div class="contact-card card" data-reveal style="--reveal-delay: 200ms">
        <span class="icon-circle"><i class="fas fa-clock" aria-hidden="true"></i></span>
        <span class="contact-label">Horário</span>
        <span class="contact-value">
          {contact.hoursLines.map((line, i) => (i === 0 ? line : <Fragment><br />{line}</Fragment>))}
        </span>
      </div>
    </div>

    <div class="location card" data-reveal>
      <div class="location-text">
        <span class="icon-circle"><i class="fas fa-location-dot" aria-hidden="true"></i></span>
        <h3 class="contact-label">Morada</h3>
        <address class="contact-value">
          {contact.addressLines.map((line, i) => (i === 0 ? line : <Fragment><br />{line}</Fragment>))}
        </address>
        <a href={contact.mapsUrl} target="_blank" rel="noopener" class="link-arrow">Abrir no Google Maps</a>
      </div>
      <iframe
        class="location-map"
        src={contact.mapEmbedUrl}
        loading="lazy"
        allowfullscreen
        title="Mapa com a localização do escritório Fernandes & Saraiva"></iframe>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 2rem;
    color: var(--text);
    text-decoration: none;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  a.contact-card:hover {
    border-color: var(--accent);
  }

  .contact-card .icon-circle {
    margin-bottom: 1rem;
  }

  .contact-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .contact-value {
    font-size: 1.35rem;
    font-weight: 600;
    font-style: normal;
    line-height: 1.4;
  }

  .contact-email {
    font-size: 1.1rem;
    overflow-wrap: anywhere;
  }

  .contact-action {
    margin-top: 0.75rem;
    color: var(--link);
    font-weight: 600;
  }

  .location {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .location-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 2rem;
  }

  .location-text .icon-circle {
    margin-bottom: 1rem;
  }

  .location-text .link-arrow {
    margin-top: 1rem;
  }

  .location-map {
    width: 100%;
    height: 100%;
    min-height: 360px;
    border: none;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .location {
      grid-template-columns: 1fr;
    }

    .location-map {
      min-height: 300px;
    }
  }
</style>
