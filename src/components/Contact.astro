---
import ContactForm from './ContactForm.astro';
import { contact } from '../data/content';
---

<section id="contact" class="section">
  <div class="container">
    <div class="section-header" data-reveal>
      <h2 class="section-title">Contactos</h2>
      <p class="section-subtitle">Ligue, escreva-nos ou visite-nos no escritório.</p>
    </div>

    <div class="contact-layout">
      <div id="mensagem" class="contact-form-column" data-reveal>
        <ContactForm />
      </div>

      <ul class="contact-details" data-reveal style="--reveal-delay: 120ms">
        <li>
          <a href={contact.phoneHref} class="detail card">
            <span class="icon-circle"><i class="fas fa-phone" aria-hidden="true"></i></span>
            <span class="detail-text">
              <span class="detail-label">Telefone</span>
              <span class="detail-value">{contact.phone}</span>
              <span class="detail-action">Ligar</span>
            </span>
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`} class="detail card">
            <span class="icon-circle"><i class="fas fa-envelope" aria-hidden="true"></i></span>
            <span class="detail-text">
              <span class="detail-label">Email</span>
              <span class="detail-value detail-email">{contact.email}</span>
              <span class="detail-action">Enviar email</span>
            </span>
          </a>
        </li>
        <li>
          <div class="detail card">
            <span class="icon-circle"><i class="fas fa-clock" aria-hidden="true"></i></span>
            <span class="detail-text">
              <span class="detail-label">Horário</span>
              <span class="detail-value">
                {contact.hoursLines.map((line, i) => (i === 0 ? line : <Fragment><br />{line}</Fragment>))}
              </span>
            </span>
          </div>
        </li>
        <li>
          <div class="detail card">
            <span class="icon-circle"><i class="fas fa-location-dot" aria-hidden="true"></i></span>
            <span class="detail-text">
              <span class="detail-label">Morada</span>
              <address class="detail-value">
                {contact.addressLines.map((line, i) => (i === 0 ? line : <Fragment><br />{line}</Fragment>))}
              </address>
              <a href={contact.mapsUrl} target="_blank" rel="noopener" class="detail-action">Abrir no Google Maps</a>
            </span>
          </div>
        </li>
      </ul>
    </div>

    <div class="map card" data-reveal>
      <iframe
        src={contact.mapEmbedUrl}
        loading="lazy"
        allowfullscreen
        title="Mapa com a localização do escritório Fernandes & Saraiva"></iframe>
    </div>
  </div>
</section>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: stretch; /* both columns end at the same height */
  }

  .contact-form-column {
    display: flex;
  }

  .contact-form-column > :global(.form-card) {
    flex: 1;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
  }

  /* The four cards share the column's height evenly */
  .contact-details > li {
    display: flex;
    flex: 1;
  }

  .contact-details .detail {
    flex: 1;
  }

  .detail {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.5rem;
    color: var(--text);
    text-decoration: none;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  a.detail:hover {
    border-color: var(--accent);
  }

  .detail .icon-circle {
    width: 52px;
    height: 52px;
    font-size: 1.3rem;
  }

  .detail-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .detail-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .detail-value {
    font-size: 1.25rem;
    font-weight: 600;
    font-style: normal;
    line-height: 1.4;
  }

  .detail-email {
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }

  .detail-action {
    margin-top: 0.4rem;
    color: var(--link);
    font-weight: 600;
    text-decoration: none;
  }

  .detail-action::after {
    content: ' ›';
  }

  a.detail-action:hover {
    text-decoration: underline;
  }

  .map {
    margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .map iframe {
    display: block;
    width: 100%;
    height: 380px;
    border: none;
  }

  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    /* On phones and tablets, phone/email/address come before the form */
    .contact-details {
      order: -1;
    }

    .map iframe {
      height: 300px;
    }
  }

  /* Small phones: tighter cards so the email address fits on one line */
  @media (max-width: 420px) {
    .detail {
      gap: 0.9rem;
      padding: 1.25rem;
    }

    .detail .icon-circle {
      width: 44px;
      height: 44px;
      font-size: 1.1rem;
    }

    .detail-email {
      font-size: 0.95rem;
    }
  }
</style>
