---
import { contact, firm, navSections } from '../data/content';
import { getLang, useTranslations, routes, sectionHref } from '../i18n';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-name">{firm.name}</p>
      <p>{t.footer.firmType}</p>
      <p>
        <a href={contact.phoneHref}>{contact.phone}</a> · <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>
    <ul class="footer-links">
      {navSections.map((section) => <li><a href={sectionHref(lang, section.id)}>{t.nav.links[section.key]}</a></li>)}
      <li><a href={routes.privacy[lang]}>{t.footer.privacy}</a></li>
    </ul>
  </div>
  <div class="container">
    <p class="footer-copy">© {year} {firm.name}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    padding: 3rem 0 2rem;
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-name {
    font-weight: 700;
    color: var(--text);
  }

  .footer a {
    color: var(--text-secondary);
  }

  .footer a:hover {
    color: var(--link);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
  }

  .footer-copy {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }
</style>
