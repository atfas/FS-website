---
import { Image } from 'astro:assets';
import { teamMembers } from '../data/content';
import { getLang, useTranslations } from '../i18n';

const t = useTranslations(getLang(Astro.url));
const team = teamMembers.map((member, i) => ({ ...member, ...t.team.members[i] }));
---

<section id="team" class="section">
  <div class="container">
    <div class="section-header" data-reveal>
      <h2 class="section-title">{t.team.title}</h2>
      <p class="section-subtitle">{t.team.subtitle}</p>
    </div>

    <div class="team-grid">
      {team.map((member, i) => (
        <article class="member card" data-reveal style={`--reveal-delay: ${i * 150}ms`}>
          <Image src={member.photo} alt={t.team.photoAlt(member.name)} width={700} class="member-photo" />
          <div class="member-info">
            <h3 class="member-name">{member.name}</h3>
            <p class="member-role">{member.role}</p>
            <p class="member-bio">{member.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .member {
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .member-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: top;
  }

  .member-info {
    padding: 2rem;
  }

  .member-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .member-role {
    margin-top: 0.25rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .member-bio {
    margin-top: 1rem;
    color: var(--text-secondary);
  }

  @media (max-width: 760px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .member-info {
      padding: 1.5rem;
    }
  }
</style>
