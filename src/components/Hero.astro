---
import { Image } from 'astro:assets';
import justicePicture from '../assets/images/justice_picture.png';
import { hero, contact } from '../data/content';
---

<section class="hero section-alt" id="top">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="hero-eyebrow">{hero.eyebrow}</p>
      <h1 class="hero-title">{hero.title}</h1>
      <p class="hero-lead">{hero.lead}</p>
      <div class="hero-actions">
        <a href={contact.phoneHref} class="button button-primary">
          <i class="fas fa-phone" aria-hidden="true"></i> Ligar {contact.phone}
        </a>
        <a href={`mailto:${contact.email}`} class="button button-secondary">
          <i class="fas fa-envelope" aria-hidden="true"></i> Enviar email
        </a>
      </div>
    </div>
    <div class="hero-image">
      <Image src={justicePicture} alt="" width={560} loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 5rem 0 4rem;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 3rem;
  }

  .hero-eyebrow {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero-lead {
    margin-top: 1.5rem;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 32ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .hero-image img {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    mix-blend-mode: multiply; /* blends the photo's grey background into the section */
  }

  @media (max-width: 860px) {
    .hero {
      padding: 3rem 0;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-lead {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .button {
      width: 100%;
    }

    .hero-image img {
      max-width: 260px;
    }
  }
</style>
