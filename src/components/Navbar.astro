---
import { Image } from 'astro:assets';
import logoIcon from '../assets/images/logo-icon.png';
import { navLinks, contact } from '../data/content';
---

<header class="navbar">
  <nav class="nav-container" aria-label="Navegação principal">
    <a href="/#top" class="logo">
      <Image src={logoIcon} alt="" width={36} height={36} class="logo-icon" loading="eager" />
      <span>Fernandes & Saraiva</span>
    </a>

    <ul class="nav-menu" id="nav-menu">
      {navLinks.map((link) => (
        <li class:list={{ 'mobile-only': link.mobileOnly }}><a href={link.href} class="nav-link">{link.label}</a></li>
      ))}
      <li class="nav-phone-mobile">
        <a href={contact.phoneHref} aria-label={`Ligar para ${contact.phone}`}>
          <i class="fas fa-phone" aria-hidden="true"></i> {contact.phone}
        </a>
      </li>
    </ul>

    <a href={contact.phoneHref} class="nav-phone" aria-label={`Ligar para ${contact.phone}`}>
      <i class="fas fa-phone" aria-hidden="true"></i> {contact.phone}
    </a>

    <button class="menu-toggle" type="button" aria-controls="nav-menu" aria-expanded="false">
      <i class="fas fa-bars" aria-hidden="true"></i>
      <span class="menu-toggle-label">Menu</span>
    </button>
  </nav>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    height: var(--nav-height);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .nav-container {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.6rem 0;
    flex-shrink: 0;
  }

  .logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
  }

  .nav-menu {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin-left: auto;
  }

  .nav-link {
    color: var(--text);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
    padding: 0.5rem 0;
    white-space: nowrap;
  }

  /* Links only shown in the phone menu (see navLinks in src/data/content.ts) */
  .mobile-only {
    display: none;
  }

  .nav-link:hover {
    color: var(--link);
  }

  .nav-phone,
  .nav-phone-mobile a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    color: var(--accent);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-phone i,
  .nav-phone-mobile i {
    font-size: 0.85em;
  }

  .nav-phone:hover {
    text-decoration: underline;
  }

  .nav-phone-mobile,
  .menu-toggle {
    display: none;
  }

  .menu-toggle {
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 1rem;
    margin-left: auto;
    background: var(--bg-alt);
    border: none;
    border-radius: 980px;
    font: inherit;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
  }

  @media (max-width: 400px) {
    .nav-container {
      gap: 1rem;
      padding: 0 1rem;
    }

    .logo {
      font-size: 1.1rem;
      gap: 0.5rem;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
    }
  }

  /* Very small phones: show only the F&S icon (the hero below shows the full name) */
  @media (max-width: 359px) {
    .logo span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* Below this width the links no longer fit comfortably, so they move into the "Menu" button */
  @media (max-width: 980px) {
    .nav-phone {
      display: none;
    }

    .nav-menu .mobile-only {
      display: block;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.5rem 1.5rem;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
    }

    .nav-menu.open {
      display: flex;
    }

    .nav-link {
      display: block;
      padding: 1rem 0;
      font-size: 1.25rem;
      border-bottom: 1px solid var(--border);
    }

    .nav-phone-mobile {
      display: block;
      padding-top: 1rem;
    }

    .nav-phone-mobile a {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('#nav-menu')!;
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const icon = toggle.querySelector('i')!;
  const label = toggle.querySelector('.menu-toggle-label')!;

  function setOpen(open: boolean) {
    menu.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    icon.classList.toggle('fa-bars', !open);
    icon.classList.toggle('fa-xmark', open);
    label.textContent = open ? 'Fechar' : 'Menu';
  }

  toggle.addEventListener('click', () => setOpen(!menu.classList.contains('open')));

  // Close the menu after choosing a link, when clicking outside it, or on Escape
  menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (menu.classList.contains('open') && !menu.contains(target) && !toggle.contains(target)) {
      setOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.classList.contains('open')) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
