---
import { Image } from 'astro:assets';
import courthouse from '../assets/images/areas_trabalho.png';
import { aboutParagraphs, facts } from '../data/content';
---

<section id="about" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Quem Somos</h2>
      <p class="section-subtitle">Uma sociedade de advogados próxima de quem precisa de ajuda.</p>
    </div>

    <Image src={courthouse} alt="Palácio da Justiça do Porto" width={1080} class="about-photo" />

    <ul class="facts">
      {facts.map((fact) => (
        <li class="fact">
          <span class="fact-value">{fact.value}</span>
          <span class="fact-label">{fact.label}</span>
        </li>
      ))}
    </ul>

    <div class="about-text">
      {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about-photo {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
    margin: 3rem 0;
    text-align: center;
  }

  .fact-value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .fact-label {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-secondary);
  }

  .about-text {
    max-width: 680px;
    margin: 0 auto;
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .about-text p + p {
    margin-top: 1.25rem;
  }

  @media (max-width: 600px) {
    .about-photo {
      aspect-ratio: 4 / 3;
    }

    .facts {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .about-text {
      font-size: 1.125rem;
    }
  }
</style>
