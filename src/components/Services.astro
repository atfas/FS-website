---
import { contact, serviceIcons } from '../data/content';
import { getLang, useTranslations } from '../i18n';

const t = useTranslations(getLang(Astro.url));
const services = t.services.items.map((title, i) => ({ title, icon: serviceIcons[i] }));
---

<section id="services" class="section">
  <div class="container">
    <div class="section-header" data-reveal>
      <h2 class="section-title">{t.services.title}</h2>
      <p class="section-subtitle">{t.services.subtitle}</p>
    </div>

    <ul class="services-grid">
      {services.map((service, i) => (
        <li class="service card" data-reveal style={`--reveal-delay: ${(i % 3) * 100}ms`}>
          <span class="icon-circle"><i class={`fas ${service.icon}`} aria-hidden="true"></i></span>
          <h3 class="service-title">{service.title}</h3>
        </li>
      ))}
    </ul>

    <p class="services-cta" data-reveal>
      {t.services.ctaBefore} <a href={contact.phoneHref}>{t.services.ctaLink}</a> {t.services.ctaAfter}
    </p>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
  }

  .service {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .service-title {
    min-width: 0;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: break-word;
    hyphens: auto; /* long words like "Contraordenacional" break with a hyphen on small phones */
  }

  .services-cta {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .services-cta a {
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
