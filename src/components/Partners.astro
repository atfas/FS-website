---
import { partner } from '../data/content';
import { getLang, useTranslations } from '../i18n';

const t = useTranslations(getLang(Astro.url));
---

<section id="partners" class="section section-alt">
  <div class="container">
    <div class="partner card" data-reveal>
      <p class="partner-label">{t.partner.label}</p>
      <h2 class="partner-name">{partner.name}</h2>
      <p class="partner-text">{t.partner.text}</p>
      <a href={partner.url} target="_blank" rel="noopener" class="link-arrow">
        {t.partner.linkLabel}
        <span class="visually-hidden">{t.partner.newWindow}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .partner {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem;
    text-align: center;
  }

  .partner-label {
    font-weight: 500;
    color: var(--text-secondary);
  }

  .partner-name {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .partner-text {
    margin: 1.25rem 0 1rem;
    color: var(--text-secondary);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .partner {
      padding: 2rem 1.5rem;
    }
  }
</style>
