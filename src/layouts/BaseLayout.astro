---
import '../styles/global.css';
import { getLang, useTranslations, routes, languages, defaultLang, type RouteName } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Which page this is, so the other-language version can be linked (see routes in src/i18n) */
  route: RouteName;
  /** Optional structured data (JSON-LD) for search engines */
  schema?: Record<string, unknown>;
}

const { title, description, route, schema } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);

const canonicalUrl = new URL(routes[route][lang], Astro.site);
const shareImageUrl = new URL('/og-image.png', Astro.site);
// Tells Google which URL is which language, so it shows the right version to each searcher
const alternates = languages.map((l) => ({
  hreflang: useTranslations(l).meta.htmlLang,
  href: new URL(routes[route][l], Astro.site).href,
}));
const xDefault = new URL(routes[route][defaultLang], Astro.site).href;
const otherOgLocales = languages.filter((l) => l !== lang).map((l) => useTranslations(l).meta.ogLocale);
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>

    <!-- Runs before the page paints, so revealed elements don't flash in and then disappear -->
    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('reveal-ready');
    </script>
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Icons (generated from brand/logo-fs.png with `npm run icons`) -->
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Card shown when the link is shared on WhatsApp, Facebook, LinkedIn, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {otherOgLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:site_name" content="Fernandes & Saraiva" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Inter is the fallback font for devices without Apple's system font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Font Awesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <slot />

    <script>
      // Reveal [data-reveal] elements once as they scroll into view
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );

      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
